NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/courier_platform
REDIS_URL=redis://localhost:6379
QUEUE_NAME=courier-orders
BULK_CONCURRENCY=10
COURIER_TIMEOUT_MS=10000
COURIER_MAX_RETRIES=3
COURIER_RETRY_BASE_DELAY_MS=500
URBANEBOLT_BASE_URL=https://uat.urbanebolt.in
URBANEBOLT_USERNAME=replace-me
URBANEBOLT_PASSWORD=replace-me
URBANEBOLT_COOKIE=
URBANEBOLT_CUSTOMER_CODE=replace-me
URBANEBOLT_SERVICE_TYPE=SDD
URBANEBOLT_AUTH_PATH=/api/v1/auth/getToken/
URBANEBOLT_CREATE_ORDER_PATH=/api/v1/services/manifest/
URBANEBOLT_TRACK_PATH=/api/v1/services/tracking-pub/?awb={awb}
URBANEBOLT_CANCEL_PATH=/api/v1/services/cancel/
